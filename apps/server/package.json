{
  "name": "trace-server",
  "type": "module",
  "exports": {
    "./constants": "./src/constants.ts",
    "./config": "./src/config.ts",
    "./imports": "./src/ingestion/import-service.ts",
    "./reports": "./src/reports-service.ts",
    "./sessions": "./src/session-discovery-service.ts",
    "./runtime": "./src/runtime.ts",
    "./http-server": "./src/http-server.ts",
    "./data-path": "./src/data-path.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "benchmark:scale": "node --expose-gc --import tsx src/performance/scale-benchmark.ts",
    "benchmark:scale:ci": "node --expose-gc --import tsx src/performance/scale-benchmark.ts --check"
  },
  "dependencies": {
    "@agent-profile/core": "workspace:*",
    "@agent-profile/contracts": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "better-sqlite3": "^11.0.0",
    "fastify": "^5.0.0",
    "simple-zstd": "^2.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.20.1",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
