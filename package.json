{
  "name": "agent-profile",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --stream --filter trace-server --filter agent-profile-web dev",
    "prestart": "pnpm build",
    "start": "pnpm --parallel --stream --filter trace-server --filter agent-profile-web start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "benchmark:scale": "pnpm --filter trace-server benchmark:scale",
    "benchmark:scale:ci": "pnpm --filter trace-server benchmark:scale:ci",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.20.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
