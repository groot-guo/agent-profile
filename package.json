{
  "name": "agent-profile",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --stream --filter trace-server --filter agent-profile-web dev",
    "prestart": "pnpm build",
    "start": "pnpm --parallel --stream --filter trace-server --filter agent-profile-web start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check:boundaries": "node scripts/check-module-boundaries.mjs",
    "check:roadmap": "node scripts/check-roadmap.mjs",
    "benchmark:scale": "pnpm --filter trace-server benchmark:scale",
    "benchmark:scale:ci": "pnpm --filter trace-server benchmark:scale:ci",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "build:release": "AGENT_PROFILE_WEB_STANDALONE=1 pnpm --filter agent-profile-web build && pnpm --filter @agent-profile/cli build && node scripts/build-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^22.20.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
